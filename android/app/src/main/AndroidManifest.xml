<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model downloads in the model manager screen -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the model manager wait for connectivity to come back instead of
         blindly polling while retrying an interrupted download -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- FR-042: the in-progress "generating…" notification and the
         completion notification both need this on API 33+; a denied/never-
         granted permission just means those notifications silently don't
         show (NotificationManagerCompat handles that) — generation itself
         and the foreground-service CPU exemption aren't gated on it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FR-042: keeps generation running (Doze/background-CPU exempt) if the
         user backgrounds the app mid-response. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PocketChatApplication"
        android:allowBackup="false"
        android:label="PocketChat"
        android:theme="@android:style/Theme.Black.NoTitleBar">

        <!-- FR-021: lets DebugLog.share() hand debug.log to another app's
             share target via a content:// URI instead of a blocked raw
             file:// one. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FR-042: see GenerationForegroundService's doc comment for why
             "dataSync" — none of Android's predefined foreground-service
             types is a precise fit for "keep an on-device compute task
             running," and dataSync is the conventional choice apps use for
             that shape of work. -->
        <service
            android:name=".chat.GenerationForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
